# ── Database ────────────────────────────────────────────────────────────────
# Docker Compose sets this automatically. For a local (non-Docker) run, point it
# at your own PostgreSQL instance.
DATABASE_URL="postgresql://ainext:ainext@localhost:5432/ainext?schema=public"

# ── Sessions ────────────────────────────────────────────────────────────────
# Signs the session cookie. MUST be changed before any real deployment.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="change-me-this-is-not-a-real-secret-generate-your-own"

# How long a login lasts, in hours.
SESSION_TTL_HOURS=12

# ── AI Assistant ────────────────────────────────────────────────────────────
# Leave blank and the assistant reports itself as "not configured" rather than
# failing — every other part of the portal works without it.
ANTHROPIC_API_KEY=

# ── File storage ────────────────────────────────────────────────────────────
# Where uploaded evidence files are written. In Docker this is a mounted volume.
UPLOAD_DIR="./uploads"
