# Express
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (Prisma). Leave DATABASE_URL unset to run the API on the bundled
# seed dataset — every endpoint still responds with the same shape, which is how
# the frontend can be developed before a database exists.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_next?schema=public"

# Optional: point the assistant at a real model instead of the local FAQ
# retriever. Without a key, /api/assistant answers from the knowledge base.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-sonnet-4-5
