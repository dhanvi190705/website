# PostgreSQL connection string (used by the app at runtime; can be a pooled
# connection, e.g. Neon's "-pooler" endpoint)
DATABASE_URL="postgresql://ainext:ainext@localhost:5432/ai_next_portal?schema=public"

# Direct (non-pooled) connection string, used only by `prisma migrate`.
# For a single local/plain Postgres instance this is identical to
# DATABASE_URL. For Neon, use the non-"-pooler" hostname.
DIRECT_URL="postgresql://ainext:ainext@localhost:5432/ai_next_portal?schema=public"

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Anthropic (Vercel AI SDK). Leave unset to run the assistant in graceful
# fallback mode with no live model calls.
ANTHROPIC_API_KEY=""

# Root admin bootstrap (used by scripts/init-admin.ts and prisma/seed.ts)
ROOT_ADMIN_NAME="AI Tech Team Admin"
ROOT_ADMIN_EMAIL="admin@rustomjee.com"
ROOT_ADMIN_PASSWORD="ChangeMe!12345"

# Local file storage
UPLOAD_DIR="public/uploads"
UPLOAD_MAX_SIZE_MB="25"
